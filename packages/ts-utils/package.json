{
  "name": "@rxova/ts-utils",
  "version": "0.2.1",
  "description": "Small, dependency-free runtime helpers shared across the rxova packages.",
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/shared.git",
    "directory": "packages/ts-utils"
  },
  "homepage": "https://github.com/rxova/shared/tree/main/packages/ts-utils#readme",
  "bugs": "https://github.com/rxova/shared/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack . --profile esm-only",
    "pack:smoke": "rxova-repo-config pack-smoke"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rxova/repo-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
