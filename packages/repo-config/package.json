{
  "name": "@rxova/repo-config",
  "version": "0.4.1",
  "description": "Repo maintenance for rxova monorepos: the verify gate, the changeset gate, pack smoke, llms.txt checks, and the shared build, test, lint and commit presets.",
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/shared.git",
    "directory": "packages/repo-config"
  },
  "homepage": "https://github.com/rxova/shared/tree/main/packages/repo-config#readme",
  "bugs": "https://github.com/rxova/shared/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rxova-repo-config": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tsdown": {
      "types": "./dist/tsdown.d.ts",
      "default": "./dist/tsdown.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./knip": {
      "types": "./dist/knip.d.ts",
      "default": "./dist/knip.js"
    },
    "./eslint": {
      "types": "./presets/eslint.d.ts",
      "default": "./presets/eslint.js"
    },
    "./commitlint": {
      "types": "./presets/commitlint.d.ts",
      "default": "./presets/commitlint.js"
    },
    "./prettier": {
      "types": "./presets/prettier.d.ts",
      "default": "./presets/prettier.js"
    },
    "./lint-staged": {
      "types": "./presets/lint-staged.d.ts",
      "default": "./presets/lint-staged.js"
    },
    "./changelog": {
      "types": "./presets/changelog.d.cts",
      "default": "./presets/changelog.cjs"
    },
    "./tsconfig.base.json": "./presets/tsconfig.base.json",
    "./tsconfig.dom.json": "./presets/tsconfig.dom.json",
    "./tsconfig.react.json": "./presets/tsconfig.react.json",
    "./tsconfig.node.json": "./presets/tsconfig.node.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "presets"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:exports": "node --import tsx src/cli/cli.ts check-exports",
    "pack:smoke": "node --import tsx src/cli/cli.ts pack-smoke"
  },
  "dependencies": {
    "prettier-plugin-astro": "^1.1.0"
  },
  "peerDependencies": {
    "@arethetypeswrong/cli": ">=0.17",
    "@changesets/changelog-github": ">=0.5",
    "@commitlint/config-conventional": ">=19",
    "@eslint/js": ">=9",
    "@playwright/test": ">=1.50",
    "@vitest/coverage-v8": ">=3",
    "eslint": ">=9",
    "eslint-plugin-astro": ">=3",
    "eslint-plugin-jsx-a11y": ">=6.10",
    "eslint-plugin-react": ">=7.37",
    "eslint-plugin-react-hooks": ">=7",
    "globals": ">=15",
    "knip": ">=5",
    "prettier": ">=3.5",
    "publint": ">=0.3",
    "tsdown": ">=0.15",
    "typescript": ">=5.5",
    "typescript-eslint": ">=8",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@arethetypeswrong/cli": {
      "optional": true
    },
    "@changesets/changelog-github": {
      "optional": true
    },
    "@commitlint/config-conventional": {
      "optional": true
    },
    "@eslint/js": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@vitest/coverage-v8": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "publint": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "repoConfig": {
    "exports": {
      "profile": "esm-only"
    }
  }
}
