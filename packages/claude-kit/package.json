{
  "name": "@rxova/claude-kit",
  "version": "0.0.0",
  "description": "A small Claude Code kit: guard hooks that enforce commit and config rules, workflow skills, and three least-privilege agents, installed by one bin.",
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/shared.git",
    "directory": "packages/claude-kit"
  },
  "homepage": "https://github.com/rxova/shared/tree/main/packages/claude-kit#readme",
  "bugs": "https://github.com/rxova/shared/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rxova-claude-kit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "content"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack . --profile esm-only",
    "pack:smoke": "rxova-repo-config pack-smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rxova/repo-config": "workspace:*",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
