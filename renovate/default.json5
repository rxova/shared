// The rxova org preset. Repositories extend it and keep only their own rules:
//
//   {
//     $schema: 'https://docs.renovatebot.com/renovate-schema.json',
//     extends: ['github>rxova/shared//renovate/default.json5'],
//   }
//
// The `.json5` extension is part of the name: Renovate looks for `.json` when a
// preset path has none. Both labels below must exist in the repository.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate rather than Dependabot, for `postUpdateOptions` below. Dependabot
  // patches the lockfile with its own logic and never runs the package manager,
  // so `dedupe:check` rejects nearly every pull request it opens. Renovate runs
  // pnpm itself.

  extends: [
    "config:recommended",

    // One pull request for everything that is not a major.
    "group:allNonMajor",
    "schedule:weekly",

    // Hold a freshly published version back for a few days. A compromised
    // release is usually caught within hours, and nothing here is urgent
    // enough to be the one that finds out first.
    "security:minimumReleaseAgeNpm",

    // `chore(deps): …`, so the pull request title is a valid commit subject
    // for commitlint.
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",

    // A major waits on the Dependency Dashboard until it is ticked, rather
    // than opening a pull request nobody asked for.
    ":approveMajorUpdates",

    // Peer ranges are a published contract, not a dependency to keep current.
    ":disablePeerDependencies",

    // Refreshes the whole lockfile monthly. `pnpm dedupe --check` re-resolves
    // against the live registry, so a lockfile goes stale on its own as
    // upstream publishes patches, with no change here at all.
    ":maintainLockFilesMonthly",
  ],

  // `skip-changeset` is what the changeset gate reads. A bump changes what the
  // repository builds with, never what it publishes, so there is no changelog
  // entry to write. Both labels must exist — see the README.
  labels: ["dependencies", "skip-changeset"],

  // Move the declared range rather than only the lockfile, so `package.json`
  // says what is actually installed.
  rangeStrategy: "bump",

  // Hold the pull request until `renovate/stability-days` passes. A major
  // approved on the Dependency Dashboard gets its branch straight away, and
  // pnpm's own `minimumReleaseAge` then fails `pnpm install` in every job of
  // a pull request opened on a release less than a day old.
  prCreation: "not-pending",

  // Run `pnpm dedupe` after updating, so what lands already satisfies the
  // `audit · sherif · knip · dedupe` job.
  postUpdateOptions: ["pnpmDedupe"],

  packageRules: [
    {
      // Actions from outside GitHub and rxova run with the caller's secrets,
      // and a tag can be moved. Pin them to a commit, with the version as a
      // comment; Renovate keeps both current.
      matchManagers: ["github-actions"],
      matchPackageNames: ["!actions/**", "!github/**", "!rxova/**"],
      pinDigests: true,
    },
    {
      // Patch and minor merge themselves once CI is green. `platformAutomerge`
      // hands that to GitHub's own auto-merge, so it waits for the required
      // `all checks` status.
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      platformAutomerge: true,
    },
    {
      // Below 1.0.0 a minor is a major: semver puts no compatibility promise on
      // the minor of a 0.x version, so `0.2.x` to `0.3.0` is free to remove
      // exports. Renovate still classifies it as `minor`, so the rule above
      // would group it with the patches and merge it on green — and green is no
      // defence, because the break lands in the consumer, not here.
      //
      // @rxova/ts-utils 0.3.0 is the case this was written for: it moved
      // `isDevelopment`, `isNonProduction` and `createDevWarner` off the main
      // entry to `@rxova/ts-utils/env` (deliberately — a free `process` in the
      // main entry made Next.js 16 resolve `node:process` and fail any service
      // worker or edge chunk that imported anything from the package). The
      // migration was one changelog line, and it broke the build of two
      // repositories that had done nothing but take a grouped "non-major" bump.
      //
      // So a 0.x minor is held for approval like a major and never automerged.
      // Patches of a 0.x still flow through the rule above.
      matchCurrentVersion: "<1.0.0",
      matchUpdateTypes: ["minor"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // Monthly lockfile maintenance follows the same path once CI is green.
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: true,
      platformAutomerge: true,
    },
    {
      // TypeScript 7 is held, not skipped: typescript-eslint declares its peer
      // as `>=4.8.4 <6.1.0` and errors on sight of TS 7, which is the whole
      // `lint` job. Written as a ceiling rather than an ignore so 6.x patches
      // and minors still come through.
      //
      // Lift it by deleting this rule once typescript-eslint accepts TS 7. It
      // lives in the preset so there is one place to lift it for every repository
      // (added 2026-09; typescript-eslint 8.70 still declares `<6.1.0`).
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      // A published package's `engines` is its Node floor, which consumers
      // install against. Raising it is a deliberate, changesetted decision, not
      // a dependency bump. The root and `apps/` engines keep updating.
      matchFileNames: ["packages/**"],
      matchDepTypes: ["engines"],
      enabled: false,
    },
  ],
}
